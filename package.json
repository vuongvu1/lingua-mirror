{
  "name": "lingua-mirror",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
